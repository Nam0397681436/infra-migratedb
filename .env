# ══════════════════════════════════════════════
#  PostgreSQL
# ══════════════════════════════════════════════

# Superuser – toàn quyền trên Postgres (CREATE/DROP DB, ROLE, …)
# Chỉ dùng để quản trị, migration. KHÔNG dùng trong app.
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=PgAdmiNnimdagpg123@
POSTGRES_DB=appdb

# User app_rw – đọc + ghi dữ liệu
# Quyền: CONNECT, USAGE schema public,
#         SELECT / INSERT / UPDATE / DELETE trên tất cả bảng,
#         USAGE / SELECT / UPDATE trên tất cả sequence.
APP_RW_USER=app_rw
APP_RW_PASSWORD=WhcgdkLK@123

# User app_ro – chỉ đọc (read-only)
# Quyền: CONNECT, USAGE schema public,
#         SELECT trên tất cả bảng.
#         default_transaction_read_only = on (tự chặn ghi).
APP_RO_USER=app_ro
APP_RO_PASSWORD=RehducntKL@123

# ══════════════════════════════════════════════
#  MinIO (S3-compatible Object Storage)
# ══════════════════════════════════════════════

# Root admin – toàn quyền trên MinIO (tạo bucket, user, policy, …)
# Chỉ dùng để quản trị. KHÔNG dùng trong app.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=MinAgchdyZL123

# Tên bucket mặc định
MINIO_BUCKET=images-cccd

# User app_rw – đọc + ghi object
# Policy: readwrite (GetObject, PutObject, DeleteObject, ListBucket, …)
MINIO_RW_USER=app_rw
MINIO_RW_PASSWORD=RWjdjsbxsvcuLK123

# User app_ro – chỉ đọc object
# Policy: readonly (GetObject, ListBucket)
MINIO_RO_USER=app_ro
MINIO_RO_PASSWORD=ROthrgdgdcgdLK123
